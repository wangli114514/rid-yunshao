# Generate a unique value with: openssl rand -hex 32
RID_INGEST_TOKEN=

# Cloud dashboard authentication. Use different, randomly generated values.
RID_ADMIN_USER=admin
RID_ADMIN_PASSWORD=
RID_SESSION_SECRET=
RID_COOKIE_SECURE=1

# Server-side deployment values. Do not commit real AMap credentials.
AMAP_KEY=
AMAP_SECURITY_CODE=
RID_WS_PATH=/ws
RID_MONITOR_LAT=39.9042
RID_MONITOR_LON=116.4074

# Airspace snapshot import limits. Coordinates must be WGS-84 / EPSG:4326.
RID_AIRSPACE_IMPORT_MAX_BYTES=20971520
RID_AIRSPACE_MAX_FEATURES=50000
RID_AIRSPACE_MAX_VERTICES_PER_FEATURE=20000
RID_AIRSPACE_MAX_TOTAL_VERTICES=1000000

# Optional authenticated UOM suitable-airspace raster reference. This short-lived
# credential stays on the server; do not put it in browser code, logs, or Git.
RID_UOM_WMS_TOKEN=

# Optional plain HTTP CONNECT relay for environments where the server cannot
# reach UOM directly. The relay must be the bundled loopback-only
# uom_connect_relay.py (or an equivalent allow-listed relay); it accepts only
# uom.caac.gov.cn:443. Never put a UOM token in this URL.
RID_UOM_WMS_PROXY=

# UOM production access is not public. Leave these empty until CAAC/UOM grants
# the USS endpoint, organization/client id, key id and cryptographic material.
# The current build deliberately reports "adapter unsupported" even when these
# values are present; it never sends an unsigned or guessed request to UOM.
RID_UOM_AIRSPACE_ENDPOINT=
RID_UOM_AIRSPACE_CLIENT_ID=
RID_UOM_AIRSPACE_CREDENTIAL=
